# Starknet RPC URLs (used by wallet operations, not for direct RPC calls)
# ============================================
# Starknet DApp Configuration
# ============================================
# Copy this file to .env and update the values as needed
# Note: All variables must start with NEXT_PUBLIC_ to be accessible in the browser

# ============================================
# Network Configuration
# ============================================
# Options: SN_MAIN (Mainnet) or SN_SEPOLIA (Testnet)
NEXT_PUBLIC_CHAIN_ID=SN_SEPOLIA

# ============================================
# Token Contract Addresses
# ============================================
NEXT_PUBLIC_ETH_TOKEN_ADDRESS=0x049d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7
NEXT_PUBLIC_STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
NEXT_PUBLIC_DAI_TOKEN_ADDRESS=0x00da114221cb83fa859dbdb4c44beeaa0bb37c7537ad5ae66fe5e0efd20e6eb3
NEXT_PUBLIC_WBTC_TOKEN_ADDRESS=0x00c6164dA852d230360333D6adE3551eE3e48124C815704f51fA7F12D8287Dcc

# ============================================
# Argent Dummy Contract Addresses
# ============================================
NEXT_PUBLIC_ARGENT_DUMMY_CONTRACT_MAINNET_ADDRESS=0x001c515f991f706039696a54f6f33730e9b0e8cc5d04187b13c2c714401acfd4
NEXT_PUBLIC_ARGENT_DUMMY_CONTRACT_SEPOLIA_ADDRESS=0x88d3cc4377a6cdfd27545a11548bd070c4e2e1e3df3d402922dbc4350b416

# ============================================
# RPC Node URLs
# ============================================
NEXT_PUBLIC_STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_9
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_9

# ============================================
# Argent Services
# ============================================
NEXT_PUBLIC_ARGENT_SESSION_SERVICE_BASE_URL=https://cloud.argent-api.com/v1
NEXT_PUBLIC_ARGENT_WEBWALLET_URL=https://sepolia-web.argent.xyz

# ============================================
# Feature Flags
# ============================================
# Set to "true" to use Sepolia dummy contract, "false" otherwise
NEXT_PUBLIC_USE_SEPOLIA_DUMMY_CONTRACT=false

# ============================================
# API Keys (Optional)
# ============================================
# Avnu Paymaster API Key (leave empty if not needed)
NEXT_PUBLIC_AVNU_API_KEY=


NEXT_PUBLIC_WS_SERVER_URL=ws://localhost:8501